# Outlier_agent LLM settings
OUTLIER_AGENT_PROVIDER=openai
OUTLIER_AGENT_API_KEY=
OUTLIER_AGENT_ENDPOINT=https://api.openai.com/v1
OUTLIER_AGENT_MODEL=gpt-4.1-mini
OUTLIER_AGENT_TEMPERATURE=0.1

# Compatibility with the official OpenAI Python client.
# If both are set, OUTLIER_AGENT_API_KEY and OUTLIER_AGENT_ENDPOINT take priority.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
