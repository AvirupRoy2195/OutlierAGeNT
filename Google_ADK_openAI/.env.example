# --- OpenAI (required) -------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: custom OpenAI-compatible endpoint (Azure, vLLM, Ollama, etc.)
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/
# OPENAI_ORG_ID=org_xxxxxxxxxxxxxxxxxxxx

# --- Model selection ---------------------------------------------------------
# LiteLLM model strings. Format: <provider>/<model>
#   openai/gpt-4o-mini   - cheap, fast, default
#   openai/gpt-4o        - stronger reasoning
#   openai/o4-mini       - reasoning model
#   azure/openai/<deployment>  - Azure OpenAI
ADK_MODEL=openai/gpt-4o-mini
# Override coordinator vs. specialists independently:
# ADK_COORDINATOR_MODEL=openai/gpt-4o
# ADK_SPECIALIST_MODEL=openai/gpt-4o-mini

# --- A2A server --------------------------------------------------------------
A2A_HOST=0.0.0.0
A2A_PORT=8001